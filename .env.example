# 'polling' for local development, 'webhook' (default) for production
BOT_MODE=

# 'on' enables the NBU coin monitor. Off by default: the shop blocks
# datacenter IPs, so it cannot work from Render or GitHub Actions.
COINS_MONITOR=

BOT_TOKEN=
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379
ALLOWED_CHATS=

# webhook mode only
WEBHOOK_DOMAIN=
PORT=3000
